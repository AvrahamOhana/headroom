      "Bash(swift test:*)",
      "Bash(swift package describe:*)",
      "Bash(swift package resolve:*)",
      "Bash(swift package show-dependencies:*)",
      "Bash(swift --version)",
      "Bash(xcodebuild build:*)",
      "Bash(xcodebuild test:*)",
      "Bash(xcodebuild clean:*)",
      "Bash(xcodebuild -list:*)",
      "Bash(xcodebuild -showsdks:*)",
      "Bash(xcodebuild -version:*)",
      "Bash(xcodebuild -showBuildSettings:*)",
      "Bash(xcode-select -p)",
      "Bash(xcrun --find:*)",
      "Bash(xcrun simctl list:*)",
      "Bash(swiftlint:*)",
      "Bash(swift-format:*)",
      "Bash(pod install:*)",
      "Bash(pod --version)",
      "Bash(brew list:*)",
      "Bash(brew --version)"
    ]
  }
}
